<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TimeSplitters · Future Perfect" Width="1152" Height="772" MinWidth="1000" MinHeight="720"
        WindowStartupLocation="CenterScreen" Background="#0B1420" Foreground="#E4EDF5" FontFamily="Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <SolidColorBrush x:Key="Muted" Color="#B4C7D8"/>
    <SolidColorBrush x:Key="Accent" Color="#86CDFF"/>
    <LinearGradientBrush x:Key="PlayChrome" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#C3E5FC" Offset="0"/><GradientStop Color="#96CFF2" Offset="1"/>
    </LinearGradientBrush>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#1B2C3E"/><Setter Property="Foreground" Value="#DFE9F2"/>
      <Setter Property="BorderBrush" Value="#3B5268"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="16,11"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="13"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Opacity" Value="0.8"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="#FFFFFF"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="Opacity" Value="0.6"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Face" Property="Opacity" Value="0.38"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Foreground" Value="#B4C7D8"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Margin" Value="0,3"/><Setter Property="Padding" Value="12,14"/>
    </Style>
    <Style x:Key="NavGlyph" TargetType="Path">
      <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
      <Setter Property="StrokeThickness" Value="1.7"/><Setter Property="StrokeLineJoin" Value="Round"/>
      <Setter Property="StrokeStartLineCap" Value="Round"/><Setter Property="StrokeEndLineCap" Value="Round"/>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="35"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="204"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border x:Name="SidebarPanel" Background="#101E2D" BorderBrush="#2C4258" BorderThickness="0,0,1,0">
      <Grid Margin="20,26,20,18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
          <StackPanel x:Name="SidebarBrand" Visibility="Collapsed" AutomationProperties.Name="TimeSplitters: Future Perfect">
            <Viewbox Width="164" HorizontalAlignment="Left">
              <Canvas Width="500" Height="187">
                <Image x:Name="SidebarLogo" Width="500" Height="187" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality">
                  <Image.Clip><GeometryGroup FillRule="EvenOdd">
                    <RectangleGeometry Rect="0,0,500,187"/>
                    <RectangleGeometry Rect="263,150,237,37"/>
                  </GeometryGroup></Image.Clip>
                </Image>
              </Canvas>
            </Viewbox>
            <Image x:Name="SidebarSubtitle" Width="150" Height="14" Stretch="Uniform" HorizontalAlignment="Left" Margin="7,6,0,0"
                   RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Future Perfect"/>
          </StackPanel>
          <StackPanel x:Name="SidebarBrandFallback">
            <TextBlock Text="TIMESPLITTERS" FontFamily="Bahnschrift" FontWeight="Bold" FontSize="16"/>
            <TextBlock Text="FUTURE PERFECT" FontSize="11" Foreground="#86CDFF" Margin="0,4,0,0"/>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="2">
          <TextBlock Text="NAVIGATION" Style="{StaticResource Label}" Margin="12,0,0,10"/>
          <Button x:Name="HomeNav" Style="{StaticResource Nav}" Background="#1D3A55" Foreground="#86CDFF" ToolTip="Game, release updates and setup" AutomationProperties.Name="Home">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Viewbox Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><Canvas Width="24" Height="24"><Path Style="{StaticResource NavGlyph}" Data="M3,11 L12,3 L21,11 M5,10 L5,21 L10,21 L10,15 L14,15 L14,21 L19,21 L19,10"/></Canvas></Viewbox>
              <TextBlock Grid.Column="1" Text="Home" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </Grid>
          </Button>
          <Button x:Name="NewsNav" Style="{StaticResource Nav}" ToolTip="Published release notes and known issues" AutomationProperties.Name="What's new">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Viewbox Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><Canvas Width="24" Height="24"><Path Style="{StaticResource NavGlyph}" Data="M4,3 L20,3 L20,21 L4,21 Z M8,7 L16,7 M8,11 L16,11 M8,15 L11,15 M8,18 L16,18"/></Canvas></Viewbox>
              <TextBlock Grid.Column="1" Text="What's new" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </Grid>
          </Button>
          <Button x:Name="SettingsNav" Style="{StaticResource Nav}" ToolTip="Keybinds, mouse, graphics and resolution" AutomationProperties.Name="Game settings">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Viewbox Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><Canvas Width="24" Height="24"><Path Style="{StaticResource NavGlyph}" Data="M4,5 L10,5 M14,5 L20,5 M4,12 L14,12 M18,12 L20,12 M4,19 L6,19 M10,19 L20,19 M10,2 L14,2 L14,8 L10,8 Z M14,9 L18,9 L18,15 L14,15 Z M6,16 L10,16 L10,22 L6,22 Z"/></Canvas></Viewbox>
              <TextBlock Grid.Column="1" Text="Game settings" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </Grid>
          </Button>
          <Button x:Name="RepairNav" Style="{StaticResource Nav}" ToolTip="Verify and repair files, review diagnostics and open logs" AutomationProperties.Name="Repair / Verify">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Viewbox Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><Canvas Width="24" Height="24"><Path Style="{StaticResource NavGlyph}" Data="M14,3 C18,1 22,5 20,9 L17,6 L14,9 L17,12 C16,13 14,13 12,12 L5,20 C3,22 1,19 3,17 L11,10 C9,7 10,4 14,3 Z"/></Canvas></Viewbox>
              <TextBlock Grid.Column="1" Text="Repair / Verify" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </Grid>
          </Button>
          <Button x:Name="SavesNav" Style="{StaticResource Nav}" ToolTip="Open your local saves folder" AutomationProperties.Name="Saves">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Viewbox Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><Canvas Width="24" Height="24"><Path Style="{StaticResource NavGlyph}" Data="M4,3 L17,3 L21,7 L21,21 L3,21 L3,3 Z M7,3 L7,9 L16,9 L16,3 M7,21 L7,14 L17,14 L17,21"/></Canvas></Viewbox>
              <TextBlock Grid.Column="1" Text="Saves" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </Grid>
          </Button>
          <Button x:Name="SupportNav" Style="{StaticResource Nav}" ToolTip="Open the project's GitHub issues" AutomationProperties.Name="Support">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Viewbox Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><Canvas Width="24" Height="24"><Path Style="{StaticResource NavGlyph}" Data="M9,9 C9,5 16,5 16,9 C16,12 12,11 12,15 M12,18 L12,18.3 M21,11 C21,5 17,2 12,2 C6,2 2,6 2,12 C2,18 6,22 12,22 C18,22 22,18 22,12"/></Canvas></Viewbox>
              <TextBlock Grid.Column="1" Text="Support" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </Grid>
          </Button>
          <Button x:Name="DiscordNav" Style="{StaticResource Nav}" ToolTip="Join the TimeSplitters: Future Perfect Recomp Discord community" AutomationProperties.Name="Discord community">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><Canvas Width="24" Height="24"><Path Fill="#AEB7FF" Data="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189Z"/></Canvas></Viewbox>
              <TextBlock Grid.Column="1" Text="Discord" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </Grid>
          </Button>
        </StackPanel>
        <StackPanel Grid.Row="3">
          <Border BorderBrush="#2D445A" BorderThickness="0,1,0,0" Padding="0,17,0,0">
            <StackPanel>
              <TextBlock Text="PC RECOMPILATION" FontSize="11" FontWeight="SemiBold" Foreground="#B7C8D8"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1">
    <Grid x:Name="CommandCenter" Margin="30,24,30,18">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="228"/><RowDefinition Height="18"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel LastChildFill="False">
        <TextBlock DockPanel.Dock="Left" Text="LAUNCHER" FontSize="12" FontWeight="SemiBold" Foreground="#C0D1E1" VerticalAlignment="Center"/>
        <Border DockPanel.Dock="Right" BorderBrush="#416685" BorderThickness="1" Background="#162F45" Padding="10,6" CornerRadius="3" VerticalAlignment="Center">
          <TextBlock x:Name="ChannelBadge" Text="●  STABLE CHANNEL" FontSize="11" Foreground="#A8D8FF"/>
        </Border>
      </DockPanel>
      <Border Grid.Row="2" BorderBrush="#476580" BorderThickness="1" CornerRadius="5" ClipToBounds="True">
        <Grid>
        <Grid x:Name="HeroFallback">
          <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0.6"><GradientStop Color="#1C344B"/><GradientStop Color="#101F30" Offset="0.62"/><GradientStop Color="#1C3F5D" Offset="1"/></LinearGradientBrush></Grid.Background>
          <Canvas HorizontalAlignment="Right" Width="390" IsHitTestVisible="False" ClipToBounds="True">
            <Path Stroke="#36536E" StrokeThickness="1" Data="M0,40 L390,40 M0,85 L390,85 M0,130 L390,130 M0,175 L390,175 M0,220 L390,220 M45,0 L45,264 M100,0 L100,264 M155,0 L155,264 M210,0 L210,264 M265,0 L265,264 M320,0 L320,264 M375,0 L375,264" Opacity="0.5"/>
            <Ellipse Canvas.Left="89" Canvas.Top="-59" Width="365" Height="365" Stroke="#4C6C89" StrokeThickness="1"/>
            <Ellipse Canvas.Left="113" Canvas.Top="-35" Width="317" Height="317" Stroke="#8EC7EF" StrokeThickness="2" StrokeDashArray="18 2 1 3"/>
            <Ellipse Canvas.Left="137" Canvas.Top="-11" Width="269" Height="269" Stroke="#86CDFF" StrokeThickness="1" Opacity="0.75"/>
            <Ellipse Canvas.Left="155" Canvas.Top="7" Width="233" Height="233" Stroke="#6386A2" StrokeThickness="12" StrokeDashArray="0.12 1.8"/>
            <Ellipse Canvas.Left="172" Canvas.Top="24" Width="199" Height="199" Stroke="#577F9F" StrokeThickness="1"/>
            <Ellipse Canvas.Left="190" Canvas.Top="42" Width="163" Height="163">
              <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#638EAD"/><GradientStop Color="#244D70" Offset="0.55"/><GradientStop Color="#0D1C2B" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
            </Ellipse>
            <Path Stroke="#86CDFF" StrokeThickness="1.5" Data="M271,22 L271,69 M271,177 L271,224 M170,123 L217,123 M325,123 L372,123 M253,123 L289,123 M271,105 L271,141"/>
            <Path Fill="#132A3D" Stroke="#B5CADB" StrokeThickness="1" Data="M243,124 L255,93 L254,74 L262,61 L276,60 L287,71 L284,94 L300,105 L304,127 L322,146 L315,154 L289,137 L290,178 L302,221 L282,224 L267,185 L260,223 L240,221 L247,174 L246,143 L220,154 L214,145 Z"/>
          </Canvas>
          <StackPanel Margin="28,25,0,20" Width="435" HorizontalAlignment="Left">
            <TextBlock Text="TIMESPLITTERS" FontFamily="Bahnschrift" FontWeight="Bold" FontStyle="Italic" FontSize="43" Margin="-3,10,0,0">
              <TextBlock.Foreground><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#F0F8FF"/><GradientStop Color="#C5D4E1" Offset="0.48"/><GradientStop Color="#7F97AE" Offset="0.52"/><GradientStop Color="#E1EBF4" Offset="1"/></LinearGradientBrush></TextBlock.Foreground>
            </TextBlock>
            <TextBlock Text="F U T U R E   P E R F E C T" FontFamily="Bahnschrift" FontWeight="Bold" FontSize="20" Foreground="#86CDFF" Margin="0,-1,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="0,19,0,0">
              <Border BorderBrush="#46637D" BorderThickness="1" Padding="8,4" CornerRadius="2"><TextBlock Text="WINDOWS x64" FontSize="10" Foreground="#CAD9E6"/></Border>
              <Border BorderBrush="#46637D" BorderThickness="1" Padding="8,4" CornerRadius="2" Margin="7,0,0,0"><TextBlock Text="NATIVE PC PORT" FontSize="10" Foreground="#CAD9E6"/></Border>
            </StackPanel>
          </StackPanel>
        </Grid>
        <Border x:Name="HeroBanner" CornerRadius="4" Visibility="Collapsed"
                AutomationProperties.Name="TimeSplitters: Future Perfect — complete original Cortez artwork">
          <Grid ClipToBounds="True">
            <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0.5"><GradientStop Color="#0B1929"/><GradientStop Color="#203E58" Offset="0.65"/><GradientStop Color="#476177" Offset="1"/></LinearGradientBrush></Grid.Background>
            <Grid.ColumnDefinitions><ColumnDefinition Width="0.55*"/><ColumnDefinition Width="0.45*"/></Grid.ColumnDefinitions>
            <Image x:Name="HeroBackdrop" Grid.ColumnSpan="2" Stretch="UniformToFill" IsHitTestVisible="False"/>
            <Border Grid.ColumnSpan="2" IsHitTestVisible="False">
              <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#85061120"/><GradientStop Color="#400A1C30" Offset="0.48"/><GradientStop Color="#000A1C30" Offset="0.7"/></LinearGradientBrush></Border.Background>
            </Border>
            <Image x:Name="HeroPhoto" Grid.Column="1" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Center"
                   AutomationProperties.Name="Complete supplied artwork, including Cortez, both weapons and his boot">
              <Image.OpacityMask><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#00FFFFFF"/><GradientStop Color="#FFFFFFFF" Offset="0.13"/></LinearGradientBrush></Image.OpacityMask>
            </Image>
            <Grid Margin="32,24,24,24">
              <Image x:Name="HeroTitle" Stretch="Uniform" MaxWidth="400" Visibility="Collapsed"
                     AutomationProperties.Name="TimeSplitters Future Perfect"/>
              <StackPanel x:Name="HeroTitleFallback" VerticalAlignment="Center">
                <TextBlock Text="TIMESPLITTERS" FontFamily="Bahnschrift" FontWeight="Bold" FontStyle="Italic" FontSize="29" Foreground="#E4EDF5"/>
                <TextBlock Text="FUTURE PERFECT" FontFamily="Bahnschrift" FontSize="18" Foreground="#A7D9FA" Margin="0,7,0,0"/>
              </StackPanel>
            </Grid>
          </Grid>
        </Border>
        </Grid>
      </Border>
      <ScrollViewer x:Name="HomeCardsScroll" Grid.Row="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
      <Grid MinHeight="{Binding ViewportHeight, ElementName=HomeCardsScroll}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="#152A3D" BorderBrush="#496C88" BorderThickness="1" CornerRadius="7" Padding="20,16">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <WrapPanel><TextBlock Text="YOUR GAME" Style="{StaticResource Label}" Margin="0,0,14,0"/><TextBlock x:Name="InstalledLabel" Text="NOT INSTALLED" Foreground="#B5DEFA" FontSize="12"/></WrapPanel>
            <TextBlock x:Name="ReadyTitle" Grid.Row="1" Text="Install game" FontSize="25" FontWeight="SemiBold" Margin="0,12,0,0"/>
            <TextBlock x:Name="ReadyDescription" Grid.Row="2" Text="Install a release, then import your US Xbox ISO." Foreground="#B4C7D8" FontSize="13" Margin="0,6,0,13"/>
            <Button x:Name="PlayButton" Grid.Row="3" Background="{StaticResource PlayChrome}" Foreground="#091C2C" BorderBrush="#D6EDFF" FontSize="16" Padding="20,13" Content="▶    PLAY GAME" ToolTip="Launch your installed game" IsEnabled="False"/>
            <StackPanel Grid.Row="4" Margin="0,18,0,0">
              <TextBlock x:Name="DataLabel" Text="○  ISO required" Foreground="#B4CCDF" FontSize="13" Margin="0,0,0,8"/>
              <Expander x:Name="GameDataExpander" Header="Set up game data" Foreground="#B5DEFA" FontSize="13" IsExpanded="True">
                <StackPanel Margin="0,8,0,0">
                  <TextBlock x:Name="GameDataHint" FontSize="13" Foreground="#B4C7D8" Margin="0,0,0,10"/>
                  <Grid x:Name="ImportActions"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Button x:Name="ImportButton" Content="Locate ISO" Padding="8,9" ToolTip="Import your supported US Xbox ISO once"/>
                    <Button x:Name="FolderButton" Grid.Column="2" Content="Use extracted files" Padding="8,9" ToolTip="Import a folder containing default.xbe, pak and xmv"/>
                  </Grid>
                  <Button x:Name="OpenDataButton" Content="Open data folder" HorizontalAlignment="Left" Visibility="Collapsed" ToolTip="Open your installed game data in File Explorer"/>
                </StackPanel>
              </Expander>
            </StackPanel>
          </Grid>
        </Border>
        <Border Grid.Column="2" Background="#102031" BorderBrush="#2D455C" BorderThickness="1" CornerRadius="7" Padding="20,16">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto" MinHeight="42"/><RowDefinition Height="Auto" MinHeight="108"/><RowDefinition Height="Auto" MinHeight="72"/><RowDefinition Height="Auto" MinHeight="80"/></Grid.RowDefinitions>
            <DockPanel>
              <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                <Viewbox Width="16" Height="16" Margin="0,0,7,0"><Canvas Width="24" Height="24"><Path x:Name="UpdateStateIcon" Stroke="#A7D9FA" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox>
                <TextBlock x:Name="UpdateStateLabel" FontSize="11" Foreground="#A7D9FA" VerticalAlignment="Center"/>
              </StackPanel>
              <TextBlock Text="UPDATES" Style="{StaticResource Label}"/>
            </DockPanel>
            <TextBlock x:Name="ReleaseTitle" Grid.Row="1" Text="Checking for updates…" FontSize="18" FontWeight="SemiBold" Margin="0,13,0,0"/>
            <StackPanel Grid.Row="2" Margin="0,7,0,14">
              <TextBlock x:Name="ReleaseDescription" Text="Game releases from GitHub." FontSize="13" Foreground="#B4C7D8"/>
              <WrapPanel Margin="0,10,0,0">
                <Button x:Name="GameVersionsButton" Content="Game versions" Margin="0,0,18,0" Padding="0,4" BorderThickness="0" Background="Transparent" Foreground="#A7D9FA" FontSize="13" ToolTip="Install a specific published game release for comparisons and bug reproduction"/>
                <Button x:Name="ReleaseNotesButton" Content="What's new" Padding="0,4" Background="Transparent" BorderThickness="0" Foreground="#A7D9FA" FontSize="13"/>
              </WrapPanel>
            </StackPanel>
            <StackPanel Grid.Row="3">
              <StackPanel x:Name="UpdateChannelSection">
                <ContentControl x:Name="GameChannelPickerHost"/>
                <TextBlock Text="Updates preserve saves and settings." Foreground="#B4C7D8" FontSize="11"/>
              </StackPanel>
              <TextBlock x:Name="TransferDetails" Visibility="Collapsed" FontSize="13" Foreground="#A7D9FA" Margin="0,10,0,8"/>
              <ProgressBar x:Name="UpdateProgress" Minimum="0" Maximum="100" Height="3" Margin="0,0,0,6" Background="#253D54" Foreground="#A7D9FA" Visibility="Hidden" BorderThickness="0" AutomationProperties.Name="Release update progress"/>
            </StackPanel>
            <Grid x:Name="UpdateActions" Grid.Row="4" Margin="0,10,0,0" VerticalAlignment="Top"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Button x:Name="UpdateButton" Content="Install release" IsEnabled="False" Padding="8,10"/>
              <Button x:Name="CheckButton" Grid.Column="2" Content="Check updates" Padding="8,10"/>
              <Button x:Name="PauseDownloadButton" Grid.ColumnSpan="3" Content="Pause download" Visibility="Collapsed" Padding="8,10"/>
            </Grid>
            <StackPanel x:Name="RecoveryActions" Grid.Row="4" Margin="0,10,0,0" Visibility="Collapsed">
              <Button x:Name="RetryButton" Content="Retry" Padding="7,10"/>
              <WrapPanel Margin="0,5,0,0">
                <Button x:Name="RecoveryRepairButton" Content="Repair / Verify" Padding="0,4" BorderThickness="0" Background="Transparent" Foreground="#A7D9FA" Margin="0,0,16,0"/>
                <Button x:Name="RecoveryLogsButton" Content="View logs ↗" Padding="0,4" BorderThickness="0" Background="Transparent" Foreground="#A7D9FA"/>
              </WrapPanel>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
      </ScrollViewer>
      <Grid Grid.Row="5" Margin="0,14,0,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="5"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="StatusText" Text="Checking for updates…" FontSize="12" Foreground="#B4C7D8" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
            <Button x:Name="RollbackButton" Content="Restore previous" FontSize="11" Foreground="#A5BDD1" Padding="0" BorderThickness="0" Background="Transparent" IsEnabled="False"
                    ToolTip="Kept until this game version opens and exits normally. Older game files are then cleaned automatically." ToolTipService.ShowOnDisabled="True"/>
            <Button x:Name="LogsButton" Content="View logs ↗" FontSize="11" Foreground="#A5BDD1" Margin="14,0,0,0" Padding="0" BorderThickness="0" Background="Transparent"/>
          </StackPanel>
        </Grid>
        <ProgressBar x:Name="OperationProgress" Grid.Row="1" Minimum="0" Maximum="100" Value="0" Background="#253D54" Foreground="#86CDFF" BorderThickness="0" Height="3"/>
      </Grid>
    </Grid>
    <ContentControl x:Name="NewsHost" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
    <ContentControl x:Name="VersionsHost" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
    <ContentControl x:Name="MaintenanceHost" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
