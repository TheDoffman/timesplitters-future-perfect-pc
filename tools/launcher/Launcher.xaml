<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TimeSplitters · Future Perfect" Width="1152" Height="772" MinWidth="1000" MinHeight="720"
        WindowStartupLocation="CenterScreen" Background="#0B1420" Foreground="#E4EDF5" FontFamily="Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <SolidColorBrush x:Key="Muted" Color="#9EAFBF"/>
    <SolidColorBrush x:Key="Accent" Color="#86CDFF"/>
    <LinearGradientBrush x:Key="PlayChrome" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#DCEFFF" Offset="0"/><GradientStop Color="#9AD6FF" Offset="0.48"/>
      <GradientStop Color="#70B8EC" Offset="0.52"/><GradientStop Color="#A5DCFF" Offset="1"/>
    </LinearGradientBrush>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#1B2C3E"/><Setter Property="Foreground" Value="#DFE9F2"/>
      <Setter Property="BorderBrush" Value="#3B5268"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="16,11"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="12"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Opacity" Value="0.8"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="#FFFFFF"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="Opacity" Value="0.6"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Face" Property="Opacity" Value="0.38"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Foreground" Value="#9EAFBF"/><Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Margin" Value="0,3"/><Setter Property="Padding" Value="12,14"/>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="35"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="204"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#101E2D" BorderBrush="#2C4258" BorderThickness="0,0,1,0">
      <Grid Margin="20,26,20,18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
          <StackPanel x:Name="SidebarBrand" Visibility="Collapsed" AutomationProperties.Name="TimeSplitters: Future Perfect">
            <Viewbox Width="164" HorizontalAlignment="Left">
              <Canvas Width="500" Height="187">
                <Image x:Name="SidebarLogo" Width="500" Height="187" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality">
                  <Image.Clip><GeometryGroup FillRule="EvenOdd">
                    <RectangleGeometry Rect="0,0,500,187"/>
                    <RectangleGeometry Rect="263,150,237,37"/>
                  </GeometryGroup></Image.Clip>
                </Image>
              </Canvas>
            </Viewbox>
            <Image x:Name="SidebarSubtitle" Width="150" Height="14" Stretch="Uniform" HorizontalAlignment="Left" Margin="7,6,0,0"
                   RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Future Perfect"/>
          </StackPanel>
          <StackPanel x:Name="SidebarBrandFallback">
            <TextBlock Text="TIMESPLITTERS" FontFamily="Bahnschrift" FontWeight="Bold" FontSize="16"/>
            <TextBlock Text="FUTURE PERFECT" FontSize="10" Foreground="#86CDFF" Margin="0,4,0,0"/>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="2">
          <TextBlock Text="OPERATIONS" Style="{StaticResource Label}" Margin="12,0,0,10"/>
          <Button x:Name="HomeNav" Style="{StaticResource Nav}" Background="#1D3A55" Foreground="#86CDFF" Content="◈    Command center" ToolTip="Game, release updates and setup"/>
          <Button x:Name="FilesNav" Style="{StaticResource Nav}" Content="▤    Game files" ToolTip="Open the installation folder"/>
          <Button x:Name="SavesNav" Style="{StaticResource Nav}" Content="◇    Saves" ToolTip="Open your local saves folder"/>
          <Button x:Name="SupportNav" Style="{StaticResource Nav}" Content="↗    Support" ToolTip="Open the project's GitHub issues"/>
        </StackPanel>
        <StackPanel Grid.Row="3">
          <Border BorderBrush="#2D445A" BorderThickness="0,1,0,0" Padding="0,17,0,0">
            <StackPanel>
              <TextBlock Text="PC RECOMPILATION" FontSize="10" FontWeight="SemiBold" Foreground="#B7C8D8"/>
              <TextBlock Text="Original era. New timeline." FontSize="11" Foreground="#849AAF" Margin="0,7,0,0"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="30,24,30,18">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="20"/><RowDefinition Height="264"/><RowDefinition Height="18"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel LastChildFill="False">
        <StackPanel DockPanel.Dock="Left"><TextBlock Text="COMMAND CENTER" FontSize="11" FontWeight="SemiBold" Foreground="#C0D1E1"/><TextBlock Text="Your next jump starts here." FontSize="13" Foreground="#8CA2B7" Margin="0,5,0,0"/></StackPanel>
        <Border DockPanel.Dock="Right" BorderBrush="#416685" BorderThickness="1" Background="#162F45" Padding="10,6" CornerRadius="3" VerticalAlignment="Center">
          <TextBlock x:Name="ChannelBadge" Text="●  STABLE CHANNEL" FontSize="10" Foreground="#A8D8FF"/>
        </Border>
      </DockPanel>
      <Border Grid.Row="2" BorderBrush="#476580" BorderThickness="1" CornerRadius="5" ClipToBounds="True">
        <Grid>
        <Grid x:Name="HeroFallback">
          <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0.6"><GradientStop Color="#1C344B"/><GradientStop Color="#101F30" Offset="0.62"/><GradientStop Color="#1C3F5D" Offset="1"/></LinearGradientBrush></Grid.Background>
          <Canvas HorizontalAlignment="Right" Width="390" IsHitTestVisible="False" ClipToBounds="True">
            <Path Stroke="#36536E" StrokeThickness="1" Data="M0,40 L390,40 M0,85 L390,85 M0,130 L390,130 M0,175 L390,175 M0,220 L390,220 M45,0 L45,264 M100,0 L100,264 M155,0 L155,264 M210,0 L210,264 M265,0 L265,264 M320,0 L320,264 M375,0 L375,264" Opacity="0.5"/>
            <Ellipse Canvas.Left="89" Canvas.Top="-59" Width="365" Height="365" Stroke="#4C6C89" StrokeThickness="1"/>
            <Ellipse Canvas.Left="113" Canvas.Top="-35" Width="317" Height="317" Stroke="#8EC7EF" StrokeThickness="2" StrokeDashArray="18 2 1 3"/>
            <Ellipse Canvas.Left="137" Canvas.Top="-11" Width="269" Height="269" Stroke="#86CDFF" StrokeThickness="1" Opacity="0.75"/>
            <Ellipse Canvas.Left="155" Canvas.Top="7" Width="233" Height="233" Stroke="#6386A2" StrokeThickness="12" StrokeDashArray="0.12 1.8"/>
            <Ellipse Canvas.Left="172" Canvas.Top="24" Width="199" Height="199" Stroke="#577F9F" StrokeThickness="1"/>
            <Ellipse Canvas.Left="190" Canvas.Top="42" Width="163" Height="163">
              <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#638EAD"/><GradientStop Color="#244D70" Offset="0.55"/><GradientStop Color="#0D1C2B" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
            </Ellipse>
            <Path Stroke="#86CDFF" StrokeThickness="1.5" Data="M271,22 L271,69 M271,177 L271,224 M170,123 L217,123 M325,123 L372,123 M253,123 L289,123 M271,105 L271,141"/>
            <Path Fill="#132A3D" Stroke="#B5CADB" StrokeThickness="1" Data="M243,124 L255,93 L254,74 L262,61 L276,60 L287,71 L284,94 L300,105 L304,127 L322,146 L315,154 L289,137 L290,178 L302,221 L282,224 L267,185 L260,223 L240,221 L247,174 L246,143 L220,154 L214,145 Z"/>
            <TextBlock Canvas.Left="22" Canvas.Top="222" Text="TEMPORAL SIGNATURE  //  2005" FontFamily="Consolas" FontSize="9" Foreground="#98B7D0"/>
          </Canvas>
          <StackPanel Margin="28,25,0,20" Width="435" HorizontalAlignment="Left">
            <TextBlock Text="THE FUTURE IS IN YOUR HANDS" FontSize="10" FontWeight="SemiBold" Foreground="#B7DFFF"/>
            <TextBlock Text="TIMESPLITTERS" FontFamily="Bahnschrift" FontWeight="Bold" FontStyle="Italic" FontSize="43" Margin="-3,10,0,0">
              <TextBlock.Foreground><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#F0F8FF"/><GradientStop Color="#C5D4E1" Offset="0.48"/><GradientStop Color="#7F97AE" Offset="0.52"/><GradientStop Color="#E1EBF4" Offset="1"/></LinearGradientBrush></TextBlock.Foreground>
            </TextBlock>
            <TextBlock Text="F U T U R E   P E R F E C T" FontFamily="Bahnschrift" FontWeight="Bold" FontSize="20" Foreground="#86CDFF" Margin="0,-1,0,0"/>
            <TextBlock Text="Back through time. Ready for PC." FontSize="13" Foreground="#B0C2D2" Margin="0,17,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="0,19,0,0">
              <Border BorderBrush="#46637D" BorderThickness="1" Padding="8,4" CornerRadius="2"><TextBlock Text="WINDOWS x64" FontSize="9" Foreground="#CAD9E6"/></Border>
              <Border BorderBrush="#46637D" BorderThickness="1" Padding="8,4" CornerRadius="2" Margin="7,0,0,0"><TextBlock Text="NATIVE PC PORT" FontSize="9" Foreground="#CAD9E6"/></Border>
            </StackPanel>
          </StackPanel>
        </Grid>
        <Border x:Name="HeroBanner" CornerRadius="4" Visibility="Collapsed"
                AutomationProperties.Name="TimeSplitters: Future Perfect — Cortez and the time portal"/>
        </Grid>
      </Border>
      <Grid Grid.Row="4">
        <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="#152435" BorderBrush="#30485F" BorderThickness="1" CornerRadius="4" Padding="20,17">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel><TextBlock Text="MISSION CONTROL" Style="{StaticResource Label}"/><TextBlock x:Name="InstalledLabel" Text="NOT INSTALLED" Foreground="#86CDFF" FontFamily="Consolas" FontSize="10" HorizontalAlignment="Right"/></DockPanel>
            <TextBlock x:Name="ReadyTitle" Grid.Row="1" Text="Prepare your next jump" FontSize="21" FontWeight="SemiBold" Margin="0,12,0,0"/>
            <TextBlock x:Name="ReadyDescription" Grid.Row="2" Text="Install a release, then import your US Xbox ISO." Foreground="#A4B8CA" FontSize="12" Margin="0,6,0,13"/>
            <Button x:Name="PlayButton" Grid.Row="3" Background="{StaticResource PlayChrome}" Foreground="#091C2C" BorderBrush="#D6EDFF" FontSize="16" Padding="20,13" Content="▶    PLAY GAME" ToolTip="Launch your installed game" IsEnabled="False"/>
            <StackPanel Grid.Row="5" Margin="0,13,0,0">
              <DockPanel><TextBlock Text="GAME DATA" Style="{StaticResource Label}"/><TextBlock x:Name="DataLabel" Text="○  ISO required" Foreground="#B4CCDF" FontSize="10" HorizontalAlignment="Right"/></DockPanel>
              <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Button x:Name="ImportButton" Content="Locate ISO" Padding="8,9" ToolTip="Import your supported US Xbox ISO once"/>
                <Button x:Name="FolderButton" Grid.Column="2" Content="Use extracted files" Padding="8,9" ToolTip="Import a folder containing default.xbe, pak and xmv"/>
              </Grid>
            </StackPanel>
          </Grid>
        </Border>
        <Border Grid.Column="2" Background="#152435" BorderBrush="#30485F" BorderThickness="1" CornerRadius="4" Padding="20,17">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel><TextBlock Text="RELEASE UPLINK" Style="{StaticResource Label}"/><Button x:Name="ReleaseNotesButton" Content="Release notes ↗" Padding="0" Background="Transparent" BorderThickness="0" Foreground="#86CDFF" FontSize="10" HorizontalAlignment="Right"/></DockPanel>
            <TextBlock x:Name="ReleaseTitle" Grid.Row="1" Text="Checking the timeline…" FontSize="19" FontWeight="SemiBold" Margin="0,13,0,0"/>
            <TextBlock x:Name="ReleaseDescription" Grid.Row="2" Text="Published releases, delivered straight from GitHub." FontSize="12" Foreground="#A4B8CA" Margin="0,7,0,12"/>
            <StackPanel Grid.Row="3">
              <DockPanel Margin="0,0,0,8"><TextBlock Text="UPDATE CHANNEL" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                <ComboBox x:Name="ChannelPicker" SelectedIndex="0" Width="104" HorizontalAlignment="Right" FontSize="11" Foreground="#101E2D" ToolTip="Stable excludes prereleases. Preview includes published test releases."><ComboBoxItem Content="Stable"/><ComboBoxItem Content="Preview"/></ComboBox>
              </DockPanel>
              <TextBlock Text="Your saves and settings stay with you." Foreground="#8CA6BE" FontSize="10"/>
            </StackPanel>
            <Grid Grid.Row="4" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Button x:Name="UpdateButton" Content="Install release" IsEnabled="False" Padding="8,10"/>
              <Button x:Name="CheckButton" Grid.Column="2" Content="Check updates" Padding="8,10"/>
            </Grid>
          </Grid>
        </Border>
      </Grid>
      <Grid Grid.Row="5" Margin="0,14,0,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="5"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="StatusText" Text="Establishing release uplink…" FontSize="11" Foreground="#B4C7D8" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
            <Button x:Name="RollbackButton" Content="Restore previous" FontSize="10" Foreground="#A5BDD1" Padding="0" BorderThickness="0" Background="Transparent" IsEnabled="False"/>
            <Button x:Name="LogsButton" Content="View logs ↗" FontSize="10" Foreground="#A5BDD1" Margin="14,0,0,0" Padding="0" BorderThickness="0" Background="Transparent"/>
          </StackPanel>
        </Grid>
        <ProgressBar x:Name="OperationProgress" Grid.Row="1" Minimum="0" Maximum="100" Value="0" Background="#253D54" Foreground="#86CDFF" BorderThickness="0" Height="3"/>
      </Grid>
    </Grid>
    <Border Grid.Row="1" Grid.ColumnSpan="2" BorderBrush="#2C435A" BorderThickness="0,1,0,0" Background="#0D1926" Padding="20,0">
      <DockPanel><TextBlock x:Name="LauncherVersionLabel" Text="TSFP  /  COMMUNITY PC PROJECT" FontFamily="Consolas" FontSize="9" Foreground="#809BB2" VerticalAlignment="Center"/><TextBlock Text="EXPERIMENTAL PORT     ·     BRING YOUR OWN GAME" FontSize="9" Foreground="#809BB2" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>
    </Border>
  </Grid>
</Window>
