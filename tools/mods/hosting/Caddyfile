{
    admin off
    auto_https off
}

http://:8766 {
    bind 127.0.0.1
    root * "{$TSFP_MOD_PUBLIC_ROOT}"
    header X-Content-Type-Options nosniff
    header Cache-Control no-store
    route {
        @write not method GET HEAD
        respond @write "Method not allowed" 405
        @catalog path /v1/catalog
        handle @catalog {
            header Content-Type application/json
            file_server
        }
        @package path_regexp package ^/v1/packages/[0-9a-f]{64}$
        handle @package {
            header Content-Type application/zip
            header Content-Disposition "attachment; filename=community-mod.zip"
            file_server
        }
        handle {
            respond "Not found" 404
        }
    }
}
