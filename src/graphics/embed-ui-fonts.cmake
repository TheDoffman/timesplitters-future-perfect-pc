# Embed immutable fonts at configure time. No runtime files or host font lookup.
get_filename_component(_font_repo "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
include("${_font_repo}/assets/ui/fonts/manifest.cmake")
if(NOT TSFP_UI_FONT_OUTPUT)
    message(FATAL_ERROR "TSFP_UI_FONT_OUTPUT is required")
endif()
file(MAKE_DIRECTORY "${TSFP_UI_FONT_OUTPUT}")
set(_font_header "/* Generated from verified assets/ui/fonts; do not edit. */\n")
foreach(_record IN LISTS TSFP_UI_FONTS)
    string(REPLACE "|" ";" _fields "${_record}")
    list(GET _fields 0 _name)
    list(GET _fields 1 _expected)
    list(GET _fields 2 _symbol)
    set(_path "${_font_repo}/assets/ui/fonts/${_name}")
    file(SHA256 "${_path}" _actual)
    if(NOT _actual STREQUAL _expected)
        message(FATAL_ERROR "UI font hash mismatch: ${_name}")
    endif()
    file(READ "${_path}" _hex HEX)
    string(REGEX REPLACE "(................................)" "\\1\n" _hex "${_hex}")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _bytes "${_hex}")
    string(APPEND _font_header "static const unsigned char pc_font_${_symbol}[]={\n${_bytes}\n};\n")
endforeach()
set(_destination "${TSFP_UI_FONT_OUTPUT}/pc_developer_font_data.h")
if(EXISTS "${_destination}")
    file(READ "${_destination}" _previous)
endif()
if(NOT _previous STREQUAL _font_header)
    file(WRITE "${_destination}" "${_font_header}")
endif()
