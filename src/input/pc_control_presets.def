PC_PAD_SOURCE(11, "pad:dpad_down")
PC_PAD_SOURCE(12, "pad:dpad_left")
PC_PAD_SOURCE(13, "pad:dpad_right")
PC_PAD_SOURCE(14, "pad:ly+")
PC_PAD_SOURCE(15, "pad:ly-")
PC_PAD_SOURCE(16, "pad:lx-")
PC_PAD_SOURCE(17, "pad:lx+")
