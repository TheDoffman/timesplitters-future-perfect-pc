/* NV2A register-combiner evaluation for the native menu path. */
"#version 330 core\n"
"in vec4 v_color;in float v_fog;\n"
"in vec4 v_uv[4];\n"
"uniform sampler2D u_tex0;\n"
"uniform sampler2D u_tex1,u_tex2,u_tex3;\n"
"uniform int u_used[4],u_flip[4],u_mode[4];uniform vec2 u_scale[4];\n"
"uniform float u_menu_filter[4];\n"
TSFP_MENU_GLSL
"uniform int u_combiner;\n"
"uniform uint u_rs[256];\n"
"uniform uvec2 u_float_mask;uniform vec4 u_float_c[16];\n"
"out vec4 frag_color;\n"
"vec4 r[16];\n"
"vec4 color(uint c){return vec4(float((c>>16u)&255u),float((c>>8u)&255u),float(c&255u),float(c>>24u))/255.0;}\n"
"vec3 inp(uint code,bool alpha){\n"
"  vec4 v=r[int(code&15u)]; vec3 x=alpha?vec3((code&16u)!=0u?v.a:v.b):((code&16u)!=0u?vec3(v.a):v.rgb);\n"
"  uint m=(code>>5u)&7u;\n"
"  if(m==0u)return max(x,vec3(0));if(m==1u)return 1.0-clamp(x,0.0,1.0);\n"
"  if(m==2u)return 2.0*max(x,vec3(0))-1.0;if(m==3u)return 1.0-2.0*max(x,vec3(0));\n"
"  if(m==4u)return max(x,vec3(0))-0.5;if(m==5u)return 0.5-max(x,vec3(0));\n"
"  if(m==6u)return x;return -x;\n"
"}\n"
"vec3 omap(vec3 v,uint o){uint m=(o>>15u)&7u;if((m&1u)!=0u)v-=0.5;uint s=m>>1u;v*=s==1u?2.0:s==2u?4.0:s==3u?0.5:1.0;return clamp(v,-1.0,1.0);}\n"
"void storeRGB(uint d,vec3 v){if(d!=0u)r[int(d)].rgb=v;}\n"
"void storeA(uint d,float v){if(d!=0u)r[int(d)].a=v;}\n"
"vec4 lookup2d(int i,vec2 uv){\n"
"  if(u_used[i]==0)return vec4(0);uv*=u_scale[i];if(u_flip[i]!=0)uv.y=1.0-uv.y;\n"
"  if(i==0)return menu_sample(u_tex0,uv,u_menu_filter[0]);if(i==1)return menu_sample(u_tex1,uv,u_menu_filter[1]);if(i==2)return menu_sample(u_tex2,uv,u_menu_filter[2]);return menu_sample(u_tex3,uv,u_menu_filter[3]);\n"
"}\n"
/* Match the PC renderer's byte-to-signed mappings; HILO mappings remain its
 * unsigned fallback. Texture stages must run in order for dependent reads. */
"vec3 dotmap(vec4 c,uint m){\n"
"  vec3 x=c.rgb*255.0;if(m==1u)return (x-128.0)/127.0;\n"
"  if(m==2u)return mix((x+0.5)/127.5,(x-255.5)/127.5,greaterThanEqual(x,vec3(128)));\n"
"  if(m==3u)return mix(x/127.0,(x-256.0)/127.0,greaterThanEqual(x,vec3(128)));return c.rgb;\n"
"}\n"
"float td[4];\n"
"vec4 sample_stage(int i){\n"
"  vec4 q=v_uv[i];int mode=u_mode[i];\n"
"  if(mode==0)return vec4(0,0,0,1);if(mode==4)return clamp(q,0.0,1.0);\n"
"  if(mode==1 || mode==32)return lookup2d(i,mode==1?q.xy/(abs(q.w)>1e-20?q.w:1.0):q.xy);\n"
"  if(i<1)return vec4(0);\n"
"  int source=i<2?0:int((u_rs[253]>>uint(8+4*i))&15u);if(source>=i)source=0;\n"
"  vec4 previous=r[8+source];\n"
"  if(mode==15 || mode==16)return lookup2d(i,mode==15?previous.ar:previous.gb);\n"
"  if((mode==17 && i<=2) || (mode==9 && i>=2)){\n"
"    uint mapping=(u_rs[252]>>uint(4*(i-1)))&15u;td[i]=dot(q.xyz,dotmap(previous,mapping));\n"
"    if(mode==9)return lookup2d(i,vec2(td[i-1],td[i]));\n"
"  }\n"
"  return vec4(0);\n"
"}\n"
"void main(){\n"
"  for(int i=0;i<16;i++)r[i]=vec4(0);for(int i=0;i<4;i++)td[i]=0.0;\n"
"  r[8]=sample_stage(0);vec4 t=r[8];\n"
"  vec4 c=v_color*(u_used[0]!=0?t:vec4(1));\n"
"  if(u_combiner!=0){\n"
"    for(int i=1;i<4;i++)r[8+i]=sample_stage(i);r[4]=clamp(v_color,0.0,1.0);r[12].a=t.a;\n"
/* The programmed factor is used even when FOGENABLE is off. Only a program
 * which never writes fog uses the enable-dependent sky/particle fallback. */
"    r[3]=vec4(color(u_rs[34]).rgb," D3D8_VSH_FOG_IS_UNWRITTEN("v_fog")
" ? (u_rs[28]!=0u?1.0:0.0) : clamp(v_fog,0.0,1.0));\n"
"    uint control=u_rs[234];int n=min(int(control&15u),8);\n"
"    for(int i=0;i<n;i++){\n"
"      int c0slot=(control&0x1000u)!=0u?i:0,c1slot=(control&0x10000u)!=0u?i:0;\n"
"      r[1]=(u_float_mask.x&(1u<<uint(c0slot)))!=0u?u_float_c[c0slot]:color(u_rs[235+c0slot]);\n"
"      r[2]=(u_float_mask.y&(1u<<uint(c1slot)))!=0u?u_float_c[8+c1slot]:color(u_rs[243+c1slot]);\n"
"      uint rgb=u_rs[210+i],a=u_rs[200+i],o=u_rs[218+i],ao=u_rs[226+i];\n"
"      vec3 A=inp(rgb>>24u,false),B=inp(rgb>>16u,false),C=inp(rgb>>8u,false),D=inp(rgb,false);\n"
"      vec3 AB=(o&0x2000u)!=0u?vec3(dot(A,B)):A*B,CD=(o&0x1000u)!=0u?vec3(dot(C,D)):C*D;\n"
"      float aa=inp(a>>24u,true).x*inp(a>>16u,true).x,ca=inp(a>>8u,true).x*inp(a,true).x;\n"
"      bool mux=(control&0x100u)!=0u?r[12].a>=0.5:(uint(clamp(r[12].a,0.0,1.0)*255.0+0.5)&1u)!=0u;\n"
"      vec3 sum=(o&0x4000u)!=0u?(mux?CD:AB):AB+CD;\n"
"      float suma=(ao&0x4000u)!=0u?(mux?ca:aa):aa+ca;\n"
"      AB=omap(AB,o);CD=omap(CD,o);sum=omap(sum,o);\n"
"      aa=omap(vec3(aa),ao).x;ca=omap(vec3(ca),ao).x;suma=omap(vec3(suma),ao).x;\n"
"      storeRGB((o>>4u)&15u,AB);storeRGB(o&15u,CD);storeRGB((o>>8u)&15u,sum);\n"
"      if((o&0x80000u)!=0u)storeA((o>>4u)&15u,AB.b);if((o&0x40000u)!=0u)storeA(o&15u,CD.b);\n"
"      storeA((ao>>4u)&15u,aa);storeA(ao&15u,ca);storeA((ao>>8u)&15u,suma);\n"
"    }\n"
"    uint f=u_rs[209];r[1]=color(u_rs[198]);r[2]=color(u_rs[199]);\n"
"    r[14].rgb=((f&0x40u)!=0u?1.0-r[5].rgb:r[5].rgb)+((f&0x20u)!=0u?1.0-r[12].rgb:r[12].rgb);\n"
"    if((f&0x80u)!=0u)r[14].rgb=clamp(r[14].rgb,0.0,1.0);\n"
"    r[15].rgb=inp(f>>24u,false)*inp(f>>16u,false);\n"
"    uint q=u_rs[208];vec3 A=inp(q>>24u,false),B=inp(q>>16u,false),C=inp(q>>8u,false),D=inp(q,false);\n"
"    c=vec4(clamp(D+A*B+(1.0-A)*C,0.0,1.0),clamp(inp(f>>8u,true).x,0.0,1.0));\n"
"  }\n"
"  if(u_rs[15]!=0u){float a=c.a,ref=float(u_rs[24]&255u)/255.0;uint f=u_rs[25];bool pass=f==8u||(f==2u&&a<ref)||(f==3u&&a==ref)||(f==4u&&a<=ref)||(f==5u&&a>ref)||(f==6u&&a!=ref)||(f==7u&&a>=ref);if(!pass)discard;}\n"
"  frag_color=c;\n"
"}\n"
