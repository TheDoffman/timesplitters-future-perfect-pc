# Shared game-side parent only. Lua executes exclusively in the separate worker.
if(TSFP_SHARED_SOURCE)
    enable_language(CXX)
    set_property(TARGET ${PROJECT_NAME} PROPERTY CXX_STANDARD 17)
    set_property(TARGET ${PROJECT_NAME} PROPERTY CXX_STANDARD_REQUIRED ON)
    set(TSFP_MOD_SOURCE "${TSFP_SHARED_SOURCE}/mods")
    if(NOT EXISTS "${CMAKE_BINARY_DIR}/generated/mod-runtime-images.h")
        message(FATAL_ERROR "Run the native game builder to generate verified mod helper pins")
    endif()
    target_include_directories(${PROJECT_NAME} PRIVATE "${CMAKE_BINARY_DIR}/generated")
    target_sources(${PROJECT_NAME} PRIVATE
        "${TSFP_MOD_SOURCE}/mod_session.cpp" "${TSFP_MOD_SOURCE}/mod_match.cpp" "${TSFP_MOD_SOURCE}/mod_manager.cpp" "${TSFP_MOD_SOURCE}/mod_runtime.cpp" "${TSFP_MOD_SOURCE}/mod_images.cpp" "${TSFP_MOD_SOURCE}/mod_saves.cpp" "${TSFP_MOD_SOURCE}/mod_capsule.cpp" "${TSFP_MOD_SOURCE}/mod_bootstrap.cpp" "${TSFP_MOD_SOURCE}/mod_resources.cpp")
    if(WIN32)
        target_sources(${PROJECT_NAME} PRIVATE "${TSFP_MOD_SOURCE}/mod_process_windows.cpp")
        target_link_libraries(${PROJECT_NAME} PRIVATE userenv advapi32 psapi ole32 bcrypt shell32)
    else()
        target_sources(${PROJECT_NAME} PRIVATE "${TSFP_MOD_SOURCE}/mod_process_posix.cpp")
        find_package(Threads REQUIRED)
        target_link_libraries(${PROJECT_NAME} PRIVATE Threads::Threads)
        if(NOT APPLE)
            find_package(OpenSSL REQUIRED)
            target_link_libraries(${PROJECT_NAME} PRIVATE OpenSSL::Crypto)
        endif()
    endif()
    target_include_directories(${PROJECT_NAME} PRIVATE "${TSFP_MOD_SOURCE}")
    if(MSVC)
        set_source_files_properties("${TSFP_MOD_SOURCE}/mod_images.cpp" "${TSFP_MOD_SOURCE}/mod_saves.cpp" "${TSFP_MOD_SOURCE}/mod_capsule.cpp" "${TSFP_MOD_SOURCE}/mod_bootstrap.cpp" "${TSFP_MOD_SOURCE}/mod_resources.cpp" "${TSFP_MOD_SOURCE}/mod_manager.cpp" "${TSFP_MOD_SOURCE}/mod_runtime.cpp" PROPERTIES COMPILE_OPTIONS "/W4;/WX;/guard:cf")
    else()
        set_source_files_properties("${TSFP_MOD_SOURCE}/mod_images.cpp" "${TSFP_MOD_SOURCE}/mod_saves.cpp" "${TSFP_MOD_SOURCE}/mod_capsule.cpp" "${TSFP_MOD_SOURCE}/mod_bootstrap.cpp" "${TSFP_MOD_SOURCE}/mod_resources.cpp" "${TSFP_MOD_SOURCE}/mod_manager.cpp" "${TSFP_MOD_SOURCE}/mod_runtime.cpp" PROPERTIES COMPILE_OPTIONS "-Wall;-Wextra;-Werror;-fstack-protector-strong")
    endif()
    target_compile_definitions(${PROJECT_NAME} PRIVATE TSFP_MOD_GAME=1)
endif()
