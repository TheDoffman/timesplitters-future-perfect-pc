# Shared game-side parent only. Lua executes exclusively in the separate worker.
if(TSFP_SHARED_SOURCE)
    enable_language(CXX)
    set_property(TARGET ${PROJECT_NAME} PROPERTY CXX_STANDARD 17)
    set_property(TARGET ${PROJECT_NAME} PROPERTY CXX_STANDARD_REQUIRED ON)
    set(TSFP_MOD_SOURCE "${TSFP_SHARED_SOURCE}/mods")
    target_sources(${PROJECT_NAME} PRIVATE
        "${TSFP_MOD_SOURCE}/mod_session.cpp" "${TSFP_MOD_SOURCE}/mod_match.cpp")
    if(WIN32)
        target_sources(${PROJECT_NAME} PRIVATE "${TSFP_MOD_SOURCE}/mod_process_windows.cpp")
        target_link_libraries(${PROJECT_NAME} PRIVATE userenv advapi32 psapi ole32)
    else()
        target_sources(${PROJECT_NAME} PRIVATE "${TSFP_MOD_SOURCE}/mod_process_posix.cpp")
        find_package(Threads REQUIRED)
        target_link_libraries(${PROJECT_NAME} PRIVATE Threads::Threads)
    endif()
    target_include_directories(${PROJECT_NAME} PRIVATE "${TSFP_MOD_SOURCE}")
    target_compile_definitions(${PROJECT_NAME} PRIVATE TSFP_MOD_GAME=1)
endif()
