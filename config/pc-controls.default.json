{
  "mouse": { "enabled": true, "sensitivity": 0.10, "invert_y": false },
  "debug": { "show_fps": false, "show_frame_time": false, "show_issues": false, "log_performance": false },
  "controllers": [
    {
      "port": 1,
      "device": "keyboard",
      "bindings": {
        "lstick_up": "key:W", "lstick_down": "key:S",
        "lstick_left": "key:A", "lstick_right": "key:D",
        "rstick_up": "none", "rstick_down": "none",
        "rstick_left": "none", "rstick_right": "none",
        "rtrigger": "key:LBUTTON", "ltrigger": ["key:G", "key:XBUTTON2"],
        "a": ["key:E", "key:SPACE"],
        "b": ["key:F", "key:MBUTTON"],
        "x": "key:R", "y": "key:Y",
        "white": "key:Z", "black": "key:X",
        "lthumb": ["key:CTRL", "key:C"], "rthumb": "key:RBUTTON",
        "dpad_up": ["key:UP", "key:PAGEUP"],
        "dpad_down": ["key:DOWN", "key:PAGEDOWN"],
        "dpad_left": ["key:LEFT", "key:F24"],
        "dpad_right": ["key:RIGHT", "key:F23"],
        "start": "key:ESCAPE", "back": "key:TAB",
        "weapon_slot_1": "key:1", "weapon_slot_2": "key:2", "weapon_slot_3": "key:3",
        "weapon_slot_4": "key:4", "weapon_slot_5": "key:5", "weapon_slot_6": "key:6",
        "weapon_slot_7": "key:7", "weapon_slot_8": "key:8", "weapon_slot_9": "key:9",
        "weapon_slot_10": "key:0"
      }
    },
    { "port": 2, "device": "none" },
    { "port": 3, "device": "none" },
    { "port": 4, "device": "none" }
  ]
}
