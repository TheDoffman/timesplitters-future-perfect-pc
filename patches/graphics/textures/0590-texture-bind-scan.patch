+/* One fresh pass per bind; no retained index or guest-content shortcut. */
+static texture_entry *bound_host_entry(IDirect3DTexture8 *host, int *framebuffer)
+{
+    texture_entry *first = NULL;
+    if (framebuffer) *framebuffer = 0;
+    if (!host) return NULL;
+    for (int i = 0; i < g_texture_count; i++) {
+        texture_entry *entry = &g_textures[i];
+        if (entry->host != host) continue;
+        if (!first) first = entry;
+        if (!framebuffer) break;
+        if (entry->framebuffer) {
+            *framebuffer = 1;
+            break;
+        }
+    }
+    return first;
+}
