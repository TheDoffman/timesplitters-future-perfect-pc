  * if the texture is not one this file can mirror. */
+/* Only an existing GPU source is authoritative. Never promote a CPU-only
+ * texture here: its native uploaded copy must remain intact. */
+IDirect3DTexture8 *hle_d3d8_rendered_texture(uint32_t va)
+{
+    for (int i=0;i<g_texture_count;i++) {
+        texture_entry *e=&g_textures[i];
+        if(e->host && e->rendered && e->va==va && e->data==HLE_MEM32(va+4) &&
+           e->format==HLE_MEM32(va+12) && e->size==HLE_MEM32(va+16)) {
+            e->used_swap=hle_d3d8_shadow_swaps();return e->host;
+        }
+    }
+    return NULL;
+}
