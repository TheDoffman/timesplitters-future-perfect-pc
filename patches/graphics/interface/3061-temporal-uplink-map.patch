+/* where an area of a 2D draw, named in the title's pixels
+ * (sw x sh), lands after the widescreen squeeze, in the same pixels. Mirrors
+ * two_d_squeeze and two_d_vertical_scale in d3d8_device.c, centred:
+ * k = 4h / 3w. Future Perfect draws its Uplink map as 2D and copies it back
+ * by the rectangle it drew to; #365's fixed 176,0-312,181 was this at
+ * 16:9 only. */
+static void uplink_placed(const RECT *in, UINT sw, UINT sh, RECT *out)
+{
+    float x0 = (float)in->left, y0 = (float)in->top;
+    float x1 = (float)in->right, y1 = (float)in->bottom;
+#if defined(TSFP_PC_CONTROLS) || defined(TSFP_NATIVE_DISPLAY)
+    if (pc_display_wide_now()) {
+        float k = pc_display_hud_scale(), cx = (float)sw * 0.5f;
+        float cy = (float)sh * 0.5f, ky = k > 1.0f ? 1.0f / k : 1.0f;
+        if (k > 1.0f) k = 1.0f;
+        x0 = cx + (x0 - cx) * k;  x1 = cx + (x1 - cx) * k;
+        y0 = cy + (y0 - cy) * ky; y1 = cy + (y1 - cy) * ky;
+    }
+#else
+    (void)sw; (void)sh;
+#endif
+    out->left = (LONG)(x0 + 0.5f);
+    out->top = (LONG)(y0 + 0.5f);
+    out->right = (LONG)(x1 + 0.5f);
+    out->bottom = (LONG)(y1 + 0.5f);
+}
