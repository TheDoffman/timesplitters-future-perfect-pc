 /* ---- Waiting ---------------------------------------------------------- */
+/* Optional owner-thread desktop service for ordinary blocking waits. Budget0
+ * only queries ownership; positive budgets service callbacks and idle at most
+ * that many milliseconds. No callback runs while an object lock is held. */
+typedef int (*w32_HostWaitPump)(DWORD maximum_idle_ms);
+void w32_SetHostWaitPump(w32_HostWaitPump pump);
