+/* Opt-in cumulative diagnostics; no file or extra clock queries normally. */
+static struct {
+    uint64_t image_updates,image_bytes,copy_calls,uniform_updates,uniform_skips;
+    uint64_t ubo_uploads,ubo_bytes,wait_calls,wait_ns,pipeline_calls,ubo_checks,ubo_reuses;
+} upload_metrics;
+static int upload_profile_enabled(void)
+{
+    static int enabled=-1;
+    if(enabled<0){const char *v=getenv("TSFP_RHI_UPLOAD_PROFILE");enabled=v && !strcmp(v,"1");}
+    return enabled;
+}
+static int upload_batch_enabled(void)
+{
+    static int enabled=-1;
+    if(enabled<0){const char *v=getenv("TSFP_RHI_UPLOAD_BASELINE");enabled=!(v && !strcmp(v,"1"));}
+    return enabled;
+}
+static uint64_t upload_clock_ns(void)
+{
+#if defined(RHI_VULKAN_SDL)
+    return SDL_GetTicksNS();
+#elif defined(_WIN32)
+    LARGE_INTEGER now,freq;QueryPerformanceCounter(&now);QueryPerformanceFrequency(&freq);
+    return (uint64_t)((double)now.QuadPart*1e9/(double)freq.QuadPart);
+#else
+    return 0;
+#endif
+}
+static void upload_note_frame(void)
+{
+    if(upload_profile_enabled() && V.frame_no && !(V.frame_no%300))
+        fprintf(stderr,"[VK-UPLOAD] frames=%llu optimized=%d images=%llu image_bytes=%llu copy_calls=%llu uniform_updates=%llu uniform_skips=%llu ubo_checks=%llu ubo_reuses=%llu ubo_uploads=%llu ubo_bytes=%llu wait_calls=%llu wait_us=%llu pipeline_calls=%llu\n",
+            (unsigned long long)V.frame_no,upload_batch_enabled(),
+            (unsigned long long)upload_metrics.image_updates,(unsigned long long)upload_metrics.image_bytes,
+            (unsigned long long)upload_metrics.copy_calls,(unsigned long long)upload_metrics.uniform_updates,
+            (unsigned long long)upload_metrics.uniform_skips,(unsigned long long)upload_metrics.ubo_checks,
+            (unsigned long long)upload_metrics.ubo_reuses,(unsigned long long)upload_metrics.ubo_uploads,
+            (unsigned long long)upload_metrics.ubo_bytes,(unsigned long long)upload_metrics.wait_calls,
+            (unsigned long long)(upload_metrics.wait_ns/1000),(unsigned long long)upload_metrics.pipeline_calls);
+}
