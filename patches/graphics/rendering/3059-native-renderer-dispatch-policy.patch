+/* Same backend list, environment override and acceptance gate as startup.
+ * This query has no selection/device side effects. */
+int rhi_startup_may_use_opengl(void)
+{
+#if defined(RHI_HAVE_OPENGL)
+    const RhiBackend *selected = g_rhi;
+    const char *name = getenv("RECOMP_D3D8_BACKEND");
+    if (name && *name) for (int i = 0; g_backends[i]; i++)
+        if (!strcmp(name, g_backends[i]->name)) { selected = g_backends[i]; break; }
+    return selected == &rhi_opengl_backend ||
+        (TSFP_OPENGL_RECOVERY_ACCEPTED && selected && !strcmp(selected->name, "vulkan"));
+#else
+    return 0;
+#endif
+}
