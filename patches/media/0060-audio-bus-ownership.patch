+/* US299C0 starts one source on a pre-created stream. Own this classification
+ * on the guest thread before SetFormat/Process, never in a host callback. */
+unsigned pc_audio_stream_scope(uint32_t record,uint32_t sound,uint32_t guest_sp)
+{
+    uint32_t flags=0;
+    if(sound<5703u && guest_readable(0x004ca9b4u,4)) {
+        uint32_t table=HLE_MEM32(0x004ca9b4u),offset=sound*20u+8u;
+        if(table && table<=UINT32_MAX-offset-4u && guest_readable(table+offset,4))
+            flags=HLE_MEM32(table+offset);
+    }
+    return pc_audio_scope_enter(pc_audio_stream_category(record,flags,
+        pc_audio_scope_bus(guest_sp)),guest_sp);
+}
