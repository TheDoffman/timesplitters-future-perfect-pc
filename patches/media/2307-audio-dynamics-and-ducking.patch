+/* Never hold buffer/stream locks together. Rate-limited host-only sampling
+ * neither advances a guest clock nor flushes a resampler tail. */
+static void pc_audio_mix_tick(uint64_t wall)
+{
+    if(!pc_audio_mix_duck_begin(wall))return;
+    int active=0;
+    lock();
+    for(unsigned i=0;i<SLOTS && !active;i++) {
+        Buffer *b=&g_buffers[i];
+        if(b->iface && b->output && b->fed && !b->paused && b->speech_audible &&
+           b->mix_bus==PC_AUDIO_DIALOGUE && buffer_level(b,NULL)>-10000)
+            active=recomp_audio_output_audible_pending(slot_of(b));
+    }
+    unlock();
+    if(!active)active=hle_dsound_stream_dialogue_active();
+    pc_audio_mix_duck_end(active,wall);
+}
 
