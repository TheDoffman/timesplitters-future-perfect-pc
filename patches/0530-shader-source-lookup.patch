+/* Avoid hashing unchanged programs at their usual source address. A guest
+ * address is only a hint: compare all current microcode against the immutable
+ * host copy on every hit, including reused or modified guest allocations. */
+static int slot_program_lookup(uint32_t source, int count,
+                               const DWORD *microcode, uint32_t *hash)
+{
+    int i;
+    for (i = 0; i < g_slot_program_count; i++)
+        if (g_slot_programs[i].source == source && g_slot_programs[i].count == count &&
+            host_vsh_same_microcode(g_slot_programs[i].host, microcode, count))
+            return i;
+    *hash = microcode_hash(microcode, count);
+    i = slot_program_find(*hash, count, microcode);
+    if (i >= 0) g_slot_programs[i].source = source;
+    return i;
 }
 
