 #define AGG_MAX 40000
 
+/* Diagnostic only: report the original instruction addresses before symbol
+ * aggregation loses their offsets. All threads have resumed before this runs.
+ * Limit output to one exact executable symbol and account for omitted rows. */
+#define SAMPLE_PC_MAX 512u
+static int pc_symbol_setting(const char *value)
+{
+    size_t n = value ? strlen(value) : 0;
+    s_pc_symbol[0] = 0;
+    if (!n || n >= sizeof s_pc_symbol || strpbrk(value, "\t\r\n")) return 0;
+    memcpy(s_pc_symbol, value, n + 1);
+    return 1;
+}
+
+static void report_pc_locations(const SampleThread *t, FILE *dump)
+{
+    unsigned i, matched = 0, emitted = 0;
+    unsigned long long samples = 0, omitted = 0;
+    if (!dump || !s_pc_symbol[0]) return;
+    fprintf(dump, "# pc\tsamples\texecutable_rva\tsymbol_offset\tfile\tline\n");
+    for (i = 0; i < SAMPLE_SLOTS; ++i) {
+        const SampleSlot *slot = &t->leaf[i];
+        const ResolvedAddr *resolved;
+        IMAGEHLP_LINE64 line;
+        DWORD displacement = 0;
+        const char *file = "?", *at;
+        unsigned source_line = 0;
+        if (!slot->addr || slot->addr < s_exe_lo || slot->addr >= s_exe_hi) continue;
+        resolved = resolve(slot->addr);
+        if (!resolved || !resolved->symbol_complete || strcmp(resolved->name, s_pc_symbol)) continue;
+        ++matched; samples += slot->count;
+        if (emitted == SAMPLE_PC_MAX) { omitted += slot->count; continue; }
+        memset(&line, 0, sizeof line);
+        line.SizeOfStruct = sizeof line;
+        if (SymGetLineFromAddr64(GetCurrentProcess(), (DWORD64)slot->addr,
+                                &displacement, &line) && line.FileName) {
+            file = line.FileName;
+            for (at = file; *at; ++at)
+                if (*at == '/' || *at == '\\') file = at + 1;
+            source_line = line.LineNumber;
+        }
+        fprintf(dump, "pc\t%u\t0x%llx\t0x%llx\t%.96s\t%u\n", slot->count,
+                (unsigned long long)(slot->addr - s_exe_lo),
+                (unsigned long long)(slot->addr - resolved->base), file, source_line);
+        ++emitted;
+    }
+    fprintf(dump, "# pc coverage: symbol=%s addresses=%u emitted=%u samples=%llu omitted_samples=%llu\n",
+            s_pc_symbol, matched, emitted, samples, omitted);
+}
+
 /* A chain folded to symbol bases, so two samples at different instructions
  * of the same captured functions count together. */
 typedef struct {
