+    RecompXmm *const _recomp_xmm6=&g_xmm6; (void)_recomp_xmm6; \
+    RecompXmm *const _recomp_xmm7=&g_xmm7; (void)_recomp_xmm7; \
+    (void)_recomp_use_refs
