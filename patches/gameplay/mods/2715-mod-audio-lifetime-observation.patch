+/* Opt-in lifetime evidence, serialized by the audio lock. No guest reads,
+   PCM copies, clock updates, allocation or source-attribution changes. */
+static void mod_audio_lifetime_trace(const char *operation,const Buffer *b,uint32_t requested,uint32_t result)
+{
+    static int enabled=-1;static unsigned lines;
+    if(enabled<0){const char *value=getenv("TSFP_MOD_AUDIO_LIFETIME_TRACE");enabled=value && value[0]=='1' && !value[1];}
+    if(!enabled || !b || !b->iface || lines>=512u)return;
+    ++lines;
+    fprintf(stderr,"[mod-audio-lifetime] op=%s event=%u iface=%08X generation=%llu raw=%u pcm=%u base=%u rate=%u align=%u loop=%u:%u flags=%u playing=%u paused=%u requested=%u result=%08X\n",
+        operation,(unsigned)b->mod_audio_event,b->iface,(unsigned long long)b->generation,
+        b->size,b->model.size_bytes,b->model.original_sample_rate,b->model.sample_rate,
+        b->model.block_align,b->model.loop_start_bytes,b->model.loop_end_bytes,
+        b->model.play_flags,(unsigned)b->model.playing,(unsigned)b->paused,requested,result);
+}
+
