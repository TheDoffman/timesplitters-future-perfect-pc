-
-from . import config
-
-# SSE scalar float opcodes we recognize (after F3 0F prefix)
-_SSE_OPCODES = {
-    0x10,  # movss xmm, m32 (load)
-    0x11,  # movss m32, xmm (store)
-    0x58,  # addss
-    0x59,  # mulss
-    0x5C,  # subss
-    0x5E,  # divss
-    0x51,  # sqrtss
-    0x5D,  # minss
-    0x5F,  # maxss
