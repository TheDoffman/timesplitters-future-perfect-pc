-def va_to_file_offset(va):
-    """Convert a virtual address to a file offset in the XBE."""
-    for name, sec_va, sec_size, sec_raw in SECTIONS:
-        if sec_va <= va < sec_va + sec_size:
-            return va - sec_va + sec_raw
-    return None
