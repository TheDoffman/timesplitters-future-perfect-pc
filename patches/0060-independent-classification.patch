-                best_score = score
-                best_cat = cat
-
-        if best_cat and best_score >= 1:
-            labels[addr] = f"game_{best_cat}"
-            propagated[addr] = {
-                "category": f"game_{best_cat}",
-                "subcategory": best_cat,
-                "confidence": 0.60,
-                "method": "string_keyword",
-            }
-            count += 1
-
-    return count
