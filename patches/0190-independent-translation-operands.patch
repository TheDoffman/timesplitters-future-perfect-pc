-def _fmt_imm(val):
-    """Format an immediate value as a C hex literal."""
-    if val == 0:
-        return "0"
-    if val <= 9:
-        return str(val)
-    if val > 0x7FFFFFFF:
-        return f"0x{val:08X}u"
-    return f"0x{val:X}"
