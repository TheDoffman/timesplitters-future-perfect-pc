+#ifdef TSFP_NATIVE_INPUT
+static const char *parse_native_mouse(const char *p)
+{
+    int enabled=1, invert=0;
+    double sensitivity=0.10;
+    char key[48];
+    p=ws(p+1);
+    while(*p && *p!='}') {
+        p=jstring(p,key,sizeof key);
+        if(!p || *(p=ws(p))!=':')return NULL;
+        p=ws(p+1);
+        if(!strcmp(key,"enabled"))enabled=strncmp(p,"false",5)!=0;
+        if(!strcmp(key,"invert_y"))invert=strncmp(p,"true",4)==0;
+        if(!strcmp(key,"sensitivity"))sensitivity=strtod(p,NULL);
+        p=jskip(p);if(!p)return NULL;
+        p=ws(p);if(*p==',')p=ws(p+1);
+    }
+    if(*p!='}')return NULL;
+    tsfp_native_mouse_config(enabled,sensitivity,invert);
+    return p+1;
+}
+#endif
+
 static int parse_config(const char *text)
 {
     const char *p = ws(text);
