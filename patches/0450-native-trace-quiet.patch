+/* Runtime diagnostic switches are startup settings, like the existing helper
+ * caches. Normal launcher play explicitly sets a zero trace budget. Collapse
+ * its disabled diagnostics into one check, without bypassing render-idle work.
+ * Presence of any diagnostic switch conservatively retains the original path.
+ * Keep settings cached per thread. Outline first-use parsing so the hot guard
+ * can inline alongside the render-idle check without another helper call. */
+static RECOMP_TLS int s_trace_quiet = -1;
+#if defined(_MSC_VER)
+__declspec(noinline)
+#else
+__attribute__((noinline))
+#endif
+static int trace_quiet_init(void)
+{
+    const char *budget = getenv("RECOMP_TRACE_BUDGET");
+    s_trace_quiet = budget && strtol(budget, NULL, 0) <= 0 &&
+        !getenv("RECOMP_WATCH_VA") && !getenv("RECOMP_DUMP_VA") &&
+        !getenv("RECOMP_TRACE_ONLY") && !getenv("RECOMP_TRACE_PROFILE");
+    return s_trace_quiet;
+}
+static inline int trace_quiet(void)
+{
+    int value = s_trace_quiet;
+    return value < 0 ? trace_quiet_init() : value;
+}
