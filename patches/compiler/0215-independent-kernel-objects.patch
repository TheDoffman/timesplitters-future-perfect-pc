-{
-    uint32_t token = bridge_handle_token(h);
-    uint32_t i = token & BRIDGE_HANDLE_MASK;
-    if ((token & 0xFF000000u) == BRIDGE_HANDLE_TAG && i < BRIDGE_HANDLE_MAX)
