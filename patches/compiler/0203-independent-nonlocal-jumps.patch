- */
-#define RECOMP_JMPBUF_SLOTS 32
-
-typedef struct {
-    uint32_t  buf_va;
-    uintptr_t stack;    /* a native address on the stack it was armed on */
-    jmp_buf   native;
-} recomp_jmp_slot;
-
-static RECOMP_TLS recomp_jmp_slot s_jmp[RECOMP_JMPBUF_SLOTS];
-static RECOMP_TLS int             s_jmp_used;
