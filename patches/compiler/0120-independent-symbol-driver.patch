-# prints it with %.8s.
-_LINE = re.compile(
-    r"^(?P<lib>[A-Za-z0-9]{1,8}?)__(?:(?P<kind>FUN|VAR|UNK)__)?"
-    r"(?P<rest>.+?) = 0x(?P<addr>[0-9a-fA-F]{1,8})$")
-_FUN = re.compile(r"^(?P<call>[a-z]+)__(?P<name>[A-Za-z_][\w@?$]*)\((?P<params>.*)\)$")
