+/* The bound pointers borrow objects from these bounded descriptor caches.
+ * A material returning to a previously used state need not create another
+ * driver object. Descriptors are zero-initialized before comparison; no guest
+ * data, geometry, dynamic stencil reference or scissor rectangle is cached. */
+#define DRAW_STATE_CACHE_SIZE 32
+#define DRAW_STATE_CACHE(name, Desc, State, create, destroy)                 \
+    typedef struct { Desc desc; State *state; } name##CacheEntry;           \
+    static name##CacheEntry name##_cache[DRAW_STATE_CACHE_SIZE];           \
+    static unsigned name##_cache_count, name##_cache_next;                 \
+    static State *name##_cache_get(const Desc *desc)                       \
+    {                                                                    \
+        unsigned i; name##CacheEntry *entry; State *state;                 \
+        for (i = 0; i < name##_cache_count; ++i)                           \
+            if (!memcmp(&name##_cache[i].desc, desc, sizeof(*desc)))       \
+                return name##_cache[i].state;                             \
+        state = create(desc);                                            \
+        if (!state) return NULL; /* Retry failures; keep existing owners. */\
+        if (name##_cache_count < DRAW_STATE_CACHE_SIZE)                    \
+            entry = &name##_cache[name##_cache_count++];                  \
+        else {                                                           \
+            entry = &name##_cache[name##_cache_next];                     \
+            name##_cache_next = (name##_cache_next + 1) % DRAW_STATE_CACHE_SIZE;\
+            destroy(entry->state);                                       \
+        }                                                                \
+        memcpy(&entry->desc, desc, sizeof(*desc));                         \
+        entry->state = state;                                            \
+        return state;                                                    \
+    }                                                                    \
+    static void name##_cache_shutdown(void)                               \
+    {                                                                    \
+        unsigned i;                                                      \
+        for (i = 0; i < name##_cache_count; ++i)                           \
+            destroy(name##_cache[i].state);                               \
+        memset(name##_cache, 0, sizeof(name##_cache));                     \
+        name##_cache_count = name##_cache_next = 0;                        \
+    }
+
+DRAW_STATE_CACHE(blend, RhiBlendDesc, RhiBlendState,
+                 rhi_blend_state_create, rhi_blend_state_destroy)
+DRAW_STATE_CACHE(depth, RhiDepthDesc, RhiDepthState,
+                 rhi_depth_state_create, rhi_depth_state_destroy)
+DRAW_STATE_CACHE(raster, RhiRasterDesc, RhiRasterState,
+                 rhi_raster_state_create, rhi_raster_state_destroy)
+#undef DRAW_STATE_CACHE
+
+static RhiBlendDesc g_last_blend_desc;
 static RhiDepthDesc g_last_ds_desc;
