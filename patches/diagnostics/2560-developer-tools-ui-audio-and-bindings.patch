+extern "C" void recomp_audio_output_game_speed(float ratio)
+{
+    if(!(ratio>=.05f && ratio<=4.f))return;
+    std::lock_guard<std::recursive_mutex> guard(output_lock);
+    if(ratio==game_speed)return;
+    game_speed=ratio;
+    for(uint32_t slot=0;slot<kVoiceCount;++slot)if(slot!=RECOMP_AUDIO_SLOT_MOVIE && voices[slot].source) {
+        HRESULT error=voices[slot].source->SetFrequencyRatio(ratio);
+        if(FAILED(error))failVoice(slot,"SetFrequencyRatio",error);
+    }
+}
