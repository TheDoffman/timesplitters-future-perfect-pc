+/* Size dispatch is per attribute, outside the vertex loop. Constant-size
+ * copies let the compiler inline common Xbox formats without changing bytes,
+ * declaration order or the original fallback for unusual attribute sizes. */
+static void push_copy_attribute(uint8_t *dst, size_t dstride, uint32_t va, uint32_t first,
+                                uint32_t sstride, uint32_t vertices, UINT size)
+{
+    uint32_t v;
+#define PUSH_COPY_BYTES(n) \
+    for (v = 0; v < vertices; v++) \
+        memcpy(dst + (size_t)v * dstride, HLE_PTR(va + (first + v) * sstride), (n))
+    switch (size) {
+    case 1: PUSH_COPY_BYTES(1); break;
+    case 2: PUSH_COPY_BYTES(2); break;
+    case 3: PUSH_COPY_BYTES(3); break;
+    case 4: PUSH_COPY_BYTES(4); break;
+    case 6: PUSH_COPY_BYTES(6); break;
+    case 8: PUSH_COPY_BYTES(8); break;
+    case 12: PUSH_COPY_BYTES(12); break;
+    case 16: PUSH_COPY_BYTES(16); break;
+    default: PUSH_COPY_BYTES(size); break;
+    }
+#undef PUSH_COPY_BYTES
+}
