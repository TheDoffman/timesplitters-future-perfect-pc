# Packaged builds and local credentials are never source uploads.
*.zip
*.7z
*.img
*.dll
*.exe
*.pdb
*.obj
.env
.env.*

# Native launcher state in a development checkout.
/.launcher/

# Save archives contain personal progress and stay local.
/Backups/
*.tsfpsave
*.tsfpsave.partial

